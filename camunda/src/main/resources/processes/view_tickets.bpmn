  <bpmn:process id="Process_088ea70" name="View Tickets" isExecutable="true">
    <bpmn:startEvent id="Event_01xa7rr" name="Add Ticket" camunda:formRef="Form_1emvp2d" camunda:formRefBinding="latest">
      <bpmn:outgoing>Flow_1iz496s</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_1bhbof1">
      <bpmn:incoming>Flow_17rqjky</bpmn:incoming>
      <bpmn:incoming>Flow_1adq1r8</bpmn:incoming>
      <bpmn:incoming>Flow_11juc5s</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_1a6szbn" name="check reponse" camunda:formRef="Form_0mcyyx5" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1rynj77</bpmn:incoming>
      <bpmn:outgoing>Flow_17rqjky</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_0tctqiw" name="view tickets request">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8888/ticket/filter?category=${category}&amp;priority=${priority}&amp;status=${status}&amp;userId=${execution.getProcessEngineServices().getIdentityService().getCurrentAuthentication().getUserId()}</camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:outputParameter name="statusCode">${statusCode}</camunda:outputParameter>
            <camunda:outputParameter name="ticketList">${S(response)}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1iz496s</bpmn:incoming>
      <bpmn:outgoing>Flow_1xkcpc2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_129ysqt">
      <bpmn:incoming>Flow_1xkcpc2</bpmn:incoming>
      <bpmn:outgoing>Flow_1rynj77</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ybkdzw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_0ejr9gl" name="request error">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="response" label="response" type="string" defaultValue="ERROR" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ybkdzw</bpmn:incoming>
      <bpmn:outgoing>Flow_1adq1r8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_1pijmn4" name="server error">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="response" label="response" type="string" defaultValue="SUCCESS" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13z8hya</bpmn:incoming>
      <bpmn:outgoing>Flow_11juc5s</bpmn:outgoing>
