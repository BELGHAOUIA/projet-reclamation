    <bpmn:sequenceFlow id="Flow_11juc5s" sourceRef="Activity_1pijmn4" targetRef="Event_1bhbof1" />
    <bpmn:sequenceFlow id="Flow_1rynj77" name="success" sourceRef="Gateway_129ysqt" targetRef="Activity_1a6szbn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${statusCode == 201 || statusCode == 200}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1xkcpc2" sourceRef="Activity_0tctqiw" targetRef="Gateway_129ysqt" />
    <bpmn:sequenceFlow id="Flow_1ybkdzw" name="error" sourceRef="Gateway_129ysqt" targetRef="Activity_0ejr9gl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${statusCode != 201 &amp;&amp; statusCode != 200}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13z8hya" name="service error" sourceRef="Event_0n1b1jg" targetRef="Activity_1pijmn4" />
