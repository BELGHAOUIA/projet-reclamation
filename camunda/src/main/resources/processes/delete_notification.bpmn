<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_notif_delete"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.45.0"
                  modeler:executionPlatform="Camunda Platform"
                  modeler:executionPlatformVersion="7.24.0">

  <bpmn:process id="Process_DeleteNotification" name="Supprimer Notification" isExecutable="true">

    <!-- Start : saisir l'ID -->
    <bpmn:startEvent id="Start_del" name="Supprimer Notification"
                     camunda:formRef="form_select_notif_id.form"
                     camunda:formRefBinding="latest">
      <bpmn:outgoing>Flow_del_start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Service task : DELETE /api/v1/notifications/{notificationId}/ -->
    <bpmn:serviceTask id="Task_del_delete" name="Supprimer la notification">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8888/api/v1/notifications/${notificationId}/</camunda:inputParameter>
            <camunda:inputParameter name="method">DELETE</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:outputParameter name="statusCode">${statusCode}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_del_start</bpmn:incoming>
      <bpmn:outgoing>Flow_del_togw</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Boundary error -->
    <bpmn:boundaryEvent id="Boundary_del_err" attachedToRef="Task_del_delete">
      <bpmn:outgoing>Flow_del_svcerr</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_del" />
    </bpmn:boundaryEvent>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="GW_del">
      <bpmn:incoming>Flow_del_togw</bpmn:incoming>
      <bpmn:outgoing>Flow_del_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_del_ko</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User task succès -->
    <bpmn:userTask id="Task_del_ok" name="Notification supprimée">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="response" label="Résultat" type="string" defaultValue="La notification a été supprimée avec succès." />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_del_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_del_end_ok</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User task erreur HTTP (404) -->
    <bpmn:userTask id="Task_del_httperr" name="Notification introuvable">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="response" label="Résultat" type="string" defaultValue="Notification introuvable. Vérifiez l'ID saisi." />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_del_ko</bpmn:incoming>
      <bpmn:outgoing>Flow_del_end_ko</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User task erreur service -->
    <bpmn:userTask id="Task_del_svcerr" name="Service indisponible">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="response" label="Résultat" type="string" defaultValue="Le service de notification est indisponible." />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_del_svcerr</bpmn:incoming>
      <bpmn:outgoing>Flow_del_end_svc</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End -->
    <bpmn:endEvent id="End_del">
      <bpmn:incoming>Flow_del_end_ok</bpmn:incoming>
      <bpmn:incoming>Flow_del_end_ko</bpmn:incoming>
      <bpmn:incoming>Flow_del_end_svc</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Flows -->
    <bpmn:sequenceFlow id="Flow_del_start"   sourceRef="Start_del"         targetRef="Task_del_delete" />
    <bpmn:sequenceFlow id="Flow_del_togw"    sourceRef="Task_del_delete"   targetRef="GW_del" />
    <bpmn:sequenceFlow id="Flow_del_ok"      name="succès" sourceRef="GW_del" targetRef="Task_del_ok">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${statusCode == 204 || statusCode == 200}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_del_ko"      name="erreur" sourceRef="GW_del" targetRef="Task_del_httperr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${statusCode != 204 &amp;&amp; statusCode != 200}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_del_svcerr"  name="service error" sourceRef="Boundary_del_err" targetRef="Task_del_svcerr" />
    <bpmn:sequenceFlow id="Flow_del_end_ok"  sourceRef="Task_del_ok"      targetRef="End_del" />
    <bpmn:sequenceFlow id="Flow_del_end_ko"  sourceRef="Task_del_httperr" targetRef="End_del" />
    <bpmn:sequenceFlow id="Flow_del_end_svc" sourceRef="Task_del_svcerr"  targetRef="End_del" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_del">
    <bpmndi:BPMNPlane id="BPMNPlane_del" bpmnElement="Process_DeleteNotification">
      <bpmndi:BPMNShape id="Start_del_di" bpmnElement="Start_del">
        <dc:Bounds x="182" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="152" y="265" width="97" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_del_delete_di" bpmnElement="Task_del_delete">
        <dc:Bounds x="280" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_del_err_di" bpmnElement="Boundary_del_err">
        <dc:Bounds x="342" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_del_di" bpmnElement="GW_del" isMarkerVisible="true">
        <dc:Bounds x="455" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_del_ok_di" bpmnElement="Task_del_ok">
        <dc:Bounds x="590" y="84" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_del_httperr_di" bpmnElement="Task_del_httperr">
        <dc:Bounds x="590" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_del_svcerr_di" bpmnElement="Task_del_svcerr">
        <dc:Bounds x="380" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_del_di" bpmnElement="End_del">
        <dc:Bounds x="762" y="212" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_del_start_di"   bpmnElement="Flow_del_start">
        <di:waypoint x="218" y="240" /><di:waypoint x="280" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_del_togw_di"    bpmnElement="Flow_del_togw">
        <di:waypoint x="380" y="240" /><di:waypoint x="455" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_del_ok_di"      bpmnElement="Flow_del_ok">
        <di:waypoint x="480" y="215" /><di:waypoint x="480" y="124" /><di:waypoint x="590" y="124" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_del_ko_di"      bpmnElement="Flow_del_ko">
        <di:waypoint x="480" y="265" /><di:waypoint x="480" y="360" /><di:waypoint x="590" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_del_svcerr_di"  bpmnElement="Flow_del_svcerr">
        <di:waypoint x="360" y="298" /><di:waypoint x="360" y="460" /><di:waypoint x="380" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_del_end_ok_di"  bpmnElement="Flow_del_end_ok">
        <di:waypoint x="690" y="124" /><di:waypoint x="780" y="124" /><di:waypoint x="780" y="212" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_del_end_ko_di"  bpmnElement="Flow_del_end_ko">
        <di:waypoint x="690" y="360" /><di:waypoint x="780" y="360" /><di:waypoint x="780" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_del_end_svc_di" bpmnElement="Flow_del_end_svc">
        <di:waypoint x="480" y="460" /><di:waypoint x="780" y="460" /><di:waypoint x="780" y="248" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
