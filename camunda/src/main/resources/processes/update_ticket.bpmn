    <bpmn:serviceTask id="Activity_0tctqiw" name="get tickets request">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8888/ticket/filter?category=${category}&amp;priority=${priority}&amp;status=${status}&amp;escalationLevel=${escalationLevel}&amp;userId=${execution.getProcessEngineServices().getIdentityService().getCurrentAuthentication().getUserId()}</camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:outputParameter name="statusCode">${statusCode}</camunda:outputParameter>
            <camunda:outputParameter name="ticketList">${S(response)}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1iz496s</bpmn:incoming>
      <bpmn:outgoing>Flow_1xkcpc2</bpmn:outgoing>
    </bpmn:serviceTask>
