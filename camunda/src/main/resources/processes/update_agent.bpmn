  <bpmn:process id="Process_146yu9t" name="update_agent" isExecutable="true" camunda:historyTimeToLive="5">
    <bpmn:startEvent id="StartEvent_1" camunda:formRef="form_recherche_agent" camunda:formRefBinding="latest">
      <bpmn:outgoing>Flow_1eqk7yq</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_1wzeljg" name="Saisir ID Agent" camunda:formRef="form_recherche_agent" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_1eqk7yq</bpmn:incoming>
      <bpmn:incoming>Flow_1f4pszz</bpmn:incoming>
      <bpmn:outgoing>Flow_0lhrnhk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1eqk7yq" sourceRef="StartEvent_1" targetRef="Activity_1wzeljg" />
    <bpmn:serviceTask id="Activity_0x2jsaz" name="Fetch Agent (GET)">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8082/agent/${agentId}</camunda:inputParameter>
            <camunda:outputParameter name="agentExiste">
              <camunda:script scriptFormat="JavaScript">var json = S(response);

if (statusCode == 200) {
    // GraalVM i-7eb "connector" fi blast "execution" fil les HTTP connectors
    connector.setVariable("firstName", json.prop("firstName").stringValue());
    connector.setVariable("lastName", json.prop("lastName").stringValue());
    connector.setVariable("email", json.prop("email").stringValue());
    connector.setVariable("phone", json.prop("phone").stringValue());
    connector.setVariable("department", json.prop("department").stringValue());
    connector.setVariable("specialty", json.prop("specialty").stringValue());
    connector.setVariable("level", json.prop("level").stringValue());
    connector.setVariable("maxTickets", json.prop("maxTickets").numberValue());
    
    true; // Hedi trjja3 true otomatik lel variable agentExiste
} else {
    connector.setVariable("messageRetour", "L'agent avec l'ID " + connector.getVariable("agentId") + " n'existe pas !");
    
    false; // Hedi trjja3 false otomatik lel variable agentExiste
}</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0lhrnhk</bpmn:incoming>
      <bpmn:outgoing>Flow_16s5fhr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0lhrnhk" sourceRef="Activity_1wzeljg" targetRef="Activity_0x2jsaz" />
    <bpmn:exclusiveGateway id="Gateway_0rnisqj" name="Agent Existe ?">
      <bpmn:incoming>Flow_16s5fhr</bpmn:incoming>
      <bpmn:outgoing>Flow_1s335oi</bpmn:outgoing>
      <bpmn:outgoing>Flow_1f4pszz</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_16s5fhr" sourceRef="Activity_0x2jsaz" targetRef="Gateway_0rnisqj" />
    <bpmn:userTask id="Activity_0ad6c14" name="Modifier les données" camunda:formRef="Form_18atljt" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_1s335oi</bpmn:incoming>
      <bpmn:incoming>Flow_1eyilpf</bpmn:incoming>
      <bpmn:outgoing>Flow_0uy2rrf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1s335oi" name="existe" sourceRef="Gateway_0rnisqj" targetRef="Activity_0ad6c14">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${agentExiste == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0ua7664" name="Action ?">
      <bpmn:incoming>Flow_0uy2rrf</bpmn:incoming>
      <bpmn:outgoing>Flow_0zcf4p6</bpmn:outgoing>
