    <bpmn:serviceTask id="Activity_16hhd5w" name="Update Agent (PUT)">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">PUT</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8082/agent/${agentId}</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{
  "firstName": "${firstName}",
  "lastName": "${lastName}",
  "email": "${email}",
  "phone": "${phone}",
  "specialty": "${specialty}",
  "level": "${level}",
  "department": "${department}",
  "maxTickets": ${maxTickets}
}</camunda:inputParameter>
            <camunda:outputParameter name="isSuccess">
              <camunda:script scriptFormat="javascript">statusCode == 200;</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="messageRetour">
              <camunda:script scriptFormat="javascript">if (statusCode == 200) {
    "Agent modifié avec succès !";
} else {
    "Erreur de validation (Bad Request).";
}</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0zcf4p6</bpmn:incoming>
      <bpmn:outgoing>Flow_0u8yplb</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
