    <bpmn:sequenceFlow id="Flow_0zcf4p6" name="modifier" sourceRef="Gateway_0ua7664" targetRef="Activity_16hhd5w">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'modifier'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0ftkl8f" name="Validation ?">
