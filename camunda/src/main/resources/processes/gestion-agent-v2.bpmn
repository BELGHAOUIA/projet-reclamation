    <bpmn:serviceTask id="Activity_1tsof2k" name="Save Agent">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8082/agent</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
  "firstName": "${firstName}",
  "lastName": "${lastName}",
  "email": "${email}",
  "phone": "${phone}",
  "specialty": "${specialty}",
  "level": "${level}",
  "department": "${department}",
  "maxTickets": ${maxTickets}
}</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:outputParameter name="isSuccess">
              <camunda:script scriptFormat="JavaScript">var json = S(response);
json.hasProp("success") ? json.prop("success").boolValue() : false;</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="messageRetour">
              <camunda:script scriptFormat="JavaScript">var json = S(response);
if (json.hasProp("message")) {
    json.prop("message").stringValue();
} else if (json.hasProp("error")) {
    json.prop("error").stringValue();
} else {
    "Réponse serveur inconnue.";
}</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
