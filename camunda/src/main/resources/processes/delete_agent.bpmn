    <bpmn:sequenceFlow id="Flow_0lr0mnu" name="Oui" sourceRef="Gateway_1odu8tn" targetRef="Activity_1ok8xw1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isSuccess == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1g7e6al" sourceRef="Activity_1ok8xw1" targetRef="Event_1yi0rqg" />
