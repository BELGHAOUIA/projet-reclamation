<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0o8rvm3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="Process_1rquelc" name="Delete_agent" isExecutable="true" camunda:historyTimeToLive="5">
    <bpmn:startEvent id="StartEvent_1" camunda:formRef="form_recherche_delete" camunda:formRefBinding="latest">
      <bpmn:outgoing>Flow_03qieed</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_1gkp1kt" name="Saisir ID Agent" camunda:formRef="form_recherche_delete" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_03qieed</bpmn:incoming>
      <bpmn:incoming>Flow_0ivmiep</bpmn:incoming>
      <bpmn:incoming>Flow_0eni5i1</bpmn:incoming>
      <bpmn:outgoing>Flow_1ods7xw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_03qieed" sourceRef="StartEvent_1" targetRef="Activity_1gkp1kt" />
    <bpmn:serviceTask id="Activity_0tn2khz" name="Fetch Agent (GET)">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8082/agent/${agentId}</camunda:inputParameter>
            <camunda:outputParameter name="agentExiste">
              <camunda:script scriptFormat="javascript">var json = S(response);

if (statusCode == 200) {
    // GraalVM i-7eb "connector" fi blast "execution" fil les HTTP connectors
    connector.setVariable("firstName", json.prop("firstName").stringValue());
    connector.setVariable("lastName", json.prop("lastName").stringValue());
    connector.setVariable("email", json.prop("email").stringValue());
    connector.setVariable("phone", json.prop("phone").stringValue());
    connector.setVariable("department", json.prop("department").stringValue());
    connector.setVariable("specialty", json.prop("specialty").stringValue());
    connector.setVariable("level", json.prop("level").stringValue());
    connector.setVariable("maxTickets", json.prop("maxTickets").numberValue());
    
    true; // Hedi trjja3 true otomatik lel variable agentExiste
} else {
    connector.setVariable("messageRetour", "L'agent avec l'ID " + connector.getVariable("agentId") + " n'existe pas !");
    
    false; // Hedi trjja3 false otomatik lel variable agentExiste
}</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ods7xw</bpmn:incoming>
      <bpmn:outgoing>Flow_0czo8qh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1ods7xw" sourceRef="Activity_1gkp1kt" targetRef="Activity_0tn2khz" />
    <bpmn:exclusiveGateway id="Gateway_0qmpt13" name="Agent Existe ?">
      <bpmn:incoming>Flow_0czo8qh</bpmn:incoming>
      <bpmn:outgoing>Flow_0ivmiep</bpmn:outgoing>
      <bpmn:outgoing>Flow_14p8fp0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0czo8qh" sourceRef="Activity_0tn2khz" targetRef="Gateway_0qmpt13" />
    <bpmn:sequenceFlow id="Flow_0ivmiep" name="Non" sourceRef="Gateway_0qmpt13" targetRef="Activity_1gkp1kt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${agentExiste == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_01z6cm8" name="Confirmer suppression" camunda:formRef="form_confirmer_delete" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_14p8fp0</bpmn:incoming>
      <bpmn:outgoing>Flow_19qbo2q</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_14p8fp0" name="Oui" sourceRef="Gateway_0qmpt13" targetRef="Activity_01z6cm8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${agentExiste == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0dcd176" name="Action ?">
      <bpmn:incoming>Flow_19qbo2q</bpmn:incoming>
      <bpmn:outgoing>Flow_1la5t5u</bpmn:outgoing>
      <bpmn:outgoing>Flow_068tb35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_19qbo2q" sourceRef="Activity_01z6cm8" targetRef="Gateway_0dcd176" />
    <bpmn:endEvent id="Event_1yi0rqg">
      <bpmn:incoming>Flow_1scolqq</bpmn:incoming>
      <bpmn:incoming>Flow_1g7e6al</bpmn:incoming>
      <bpmn:incoming>Flow_1dng3md</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1la5t5u" name="Annuler" sourceRef="Gateway_0dcd176" targetRef="Activity_01py3p7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'annuler'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_01py3p7" name="Confirmation annulation" camunda:formRef="annulation" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1la5t5u</bpmn:incoming>
      <bpmn:outgoing>Flow_1scolqq</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1scolqq" sourceRef="Activity_01py3p7" targetRef="Event_1yi0rqg" />
    <bpmn:serviceTask id="Activity_10wx9u0" name="Delete Agent (DELETE)">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">DELETE</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8082/agent/${agentId}</camunda:inputParameter>
            <camunda:outputParameter name="isSuccess">
              <camunda:script scriptFormat="javascript">statusCode == 200 || statusCode == 204;</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="messageRetour">
              <camunda:script scriptFormat="javascript">(statusCode == 200 || statusCode == 204) ? "Agent supprimé avec succès !" : "Erreur lors de la suppression.";</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_068tb35</bpmn:incoming>
      <bpmn:outgoing>Flow_17c8bfe</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_068tb35" name="Supprimer" sourceRef="Gateway_0dcd176" targetRef="Activity_10wx9u0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'supprimer'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1odu8tn" name="Validation ?">
      <bpmn:incoming>Flow_17c8bfe</bpmn:incoming>
      <bpmn:outgoing>Flow_0eni5i1</bpmn:outgoing>
      <bpmn:outgoing>Flow_0lr0mnu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_17c8bfe" sourceRef="Activity_10wx9u0" targetRef="Gateway_1odu8tn" />
    <bpmn:sequenceFlow id="Flow_0eni5i1" name="Non" sourceRef="Gateway_1odu8tn" targetRef="Activity_1gkp1kt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isSuccess == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_1ok8xw1" name="Succès Delete" camunda:formRef="form_succes_delete" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_0lr0mnu</bpmn:incoming>
      <bpmn:outgoing>Flow_1g7e6al</bpmn:outgoing>
