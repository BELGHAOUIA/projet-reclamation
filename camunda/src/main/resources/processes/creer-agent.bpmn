<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1rg1wat" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="Process_0duwh8t" name="Gestion Agent" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" camunda:formRef="Form_0qe67te" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_1v41wov</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_0teicha" name="Saisir données agent" camunda:formRef="Form_0qe67te" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_1v41wov</bpmn:incoming>
      <bpmn:outgoing>Flow_0po8fek</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1v41wov" sourceRef="StartEvent_1" targetRef="Activity_0teicha" />
    <bpmn:serviceTask id="Activity_1ug66vt" name="Save Agent">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8082/agent</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{
  "firstName": "${firstName}",
  "lastName": "${lastName}",
  "email": "${email}",
  "phone": "${phone}",
  "specialty": "${specialty}",
  "level": "${level}",
  "department": "${department}",
  "maxTickets": ${maxTickets}
}</camunda:inputParameter>
            <camunda:outputParameter name="response">${response}</camunda:outputParameter>
            <camunda:outputParameter name="statusCode">${statusCode}</camunda:outputParameter>
            <camunda:outputParameter name="messageRetour">var status = statusCode.toString();

if (status == "201" || status == "200") {
    // Si ton API répond avec ton objet ApiResponse
    S(response).prop("message").stringValue();
} else {
    try {
        // On essaie d'extraire le message d'erreur de ton ApiResponse
        S(response).prop("message").stringValue();
    } catch(e) {
        // Fallback si le JSON est mal formé ou si c'est une erreur 500 brute
        "Une erreur est survenue lors de la validation des données.";
    }
}</camunda:outputParameter>
            <camunda:outputParameter name="isSuccess">var jsonResponse = S(response);
// Si le champ 'success' existe, on prend sa valeur, sinon on met false (par échec)
jsonResponse.hasProp("success") ? jsonResponse.prop("success").boolValue() : false;</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
        <camunda:inputOutput>
          <camunda:inputParameter name="errorResponseParameter">statusCode</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0po8fek</bpmn:incoming>
      <bpmn:incoming>Flow_016c5oj</bpmn:incoming>
      <bpmn:outgoing>Flow_02u9yt3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0sxyceo">
      <bpmn:incoming>Flow_0k8fl14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_0ejk8av" name="Corriger les données de l&#39;agent" camunda:formRef="Form_18atljt" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>flowNonValide</bpmn:incoming>
      <bpmn:outgoing>Flow_016c5oj</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_02u9yt3" sourceRef="Activity_1ug66vt" targetRef="checkValidationGateway" />
    <bpmn:exclusiveGateway id="checkValidationGateway" name="Données valides ?">
      <bpmn:incoming>Flow_02u9yt3</bpmn:incoming>
      <bpmn:outgoing>Flow_1vbsmj8</bpmn:outgoing>
      <bpmn:outgoing>flowNonValide</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1vbsmj8" name="flowValide" sourceRef="checkValidationGateway" targetRef="Activity_0cymujq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isSuccess == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowNonValide" name="non validé" sourceRef="checkValidationGateway" targetRef="Activity_0ejk8av">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isSuccess == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0po8fek" sourceRef="Activity_0teicha" targetRef="Activity_1ug66vt" />
    <bpmn:userTask id="Activity_0cymujq" name="Agent créé" camunda:formRef="Form_0jrewzx" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_1vbsmj8</bpmn:incoming>
      <bpmn:outgoing>Flow_0k8fl14</bpmn:outgoing>
    </bpmn:userTask>
