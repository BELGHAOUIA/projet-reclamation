<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1rg1wat" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="Process_0duwh8t" name="Gestion Agent" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" camunda:formRef="Form_0qe67te" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_1v41wov</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_0teicha" name="Saisir données agent" camunda:formRef="Form_0qe67te" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_1v41wov</bpmn:incoming>
      <bpmn:outgoing>Flow_0aksuso</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1v41wov" sourceRef="StartEvent_1" targetRef="Activity_0teicha" />
    <bpmn:serviceTask id="Activity_1ug66vt" name="Save Agent">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8082/agent</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{
  "firstName": "${firstName}",
  "lastName": "${lastName}",
  "email": "${email}",
  "phone": "${phone}",
  "specialty": "${specialty}",
  "level": "${level}",
  "department": "${department}",
  "maxTickets": ${maxTickets}
}</camunda:inputParameter>
            <camunda:outputParameter name="response">${S(response)}</camunda:outputParameter>
            <camunda:outputParameter name="statusCode">
              <camunda:script scriptFormat="javascript">// Si le serveur renvoie une erreur (400, 500, etc.)
if (connector.getVariable("statusCode") &gt;= 400) {
    // On extrait la réponse texte du serveur (ex: "Le numéro doit contenir 8 chiffres")
    var ErrorMsg = connector.getVariable("response"); 
    
    // On sauvegarde ce message dans une variable Camunda globale
    connector.setVariable("messageErreurServeur", ErrorMsg);
    
    // On déclenche l'éclair
    throw new org.camunda.bpm.engine.delegate.BpmnError("erreur_serveur");
}</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
        <camunda:inputOutput>
          <camunda:inputParameter name="errorResponseParameter">statusCode</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0aksuso</bpmn:incoming>
      <bpmn:incoming>Flow_0zkilrj</bpmn:incoming>
      <bpmn:outgoing>Flow_02u9yt3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0sxyceo">
      <bpmn:incoming>Flow_02u9yt3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_0ejk8av" name="Corriger les données de l&#39;agent" camunda:formRef="Form_0qe67te" camunda:formRefBinding="latest">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="messageErreurServeur">${messageErreurServeur}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_100w2ow</bpmn:incoming>
      <bpmn:outgoing>Flow_0zkilrj</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0aksuso" sourceRef="Activity_0teicha" targetRef="Activity_1ug66vt" />
    <bpmn:sequenceFlow id="Flow_0zkilrj" sourceRef="Activity_0ejk8av" targetRef="Activity_1ug66vt" />
    <bpmn:boundaryEvent id="Event_1y4jcz6" attachedToRef="Activity_1ug66vt">
      <bpmn:outgoing>Flow_100w2ow</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_14lpqhc" camunda:errorCodeVariable="erreur_serveur" />
